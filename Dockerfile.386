FROM --platform=linux/386 ubuntu:bionic

RUN apt-get update && \
    apt-get install -y curl build-essential gdb python3 && \
    rm -rf /var/lib/apt/lists/*

# Host ./bof.c -> Container /app/bof.c
COPY bof.c /app/bof.c
WORKDIR /app

# Settings for binary execution when running a container
RUN gcc -m32 bof.c -o bof -z execstack -fno-stack-protector

CMD ["/bin/bash"]